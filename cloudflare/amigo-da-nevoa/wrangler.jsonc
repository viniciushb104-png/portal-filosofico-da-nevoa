{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amigo-da-nevoa",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_QUEUE",
        "class_name": "NevoaQueue"
      }
    ]
  },
  "exports": {
    "NevoaQueue": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
